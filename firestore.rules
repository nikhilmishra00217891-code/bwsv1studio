
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user has a specific role
    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null; // Allow any authenticated user to read profiles (for avatars, names etc.)
      allow update: if request.auth != null && request.auth.uid == userId; // Users can only update their own profile
      allow create: if request.auth != null; // Any authenticated user can create their own profile
    }

    // Site content (for editable text)
    match /siteContent/{docId} {
        allow read: if true;
        allow write: if request.auth != null && isRole('faculty');
    }

    // Announcements
    match /announcements/{announcementId} {
      // Any authenticated user can list/read announcements
      allow list, get: if request.auth != null;
      
      // Only faculty can create announcements
      allow create: if request.auth != null && isRole('faculty');

      // Authenticated users can update reactions, but nothing else
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }
  }
}
