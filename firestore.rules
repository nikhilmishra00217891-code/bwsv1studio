rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isFaculty() {
      return request.auth.token.role == 'faculty';
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isEnrolled(courseId) {
      // Check if the user is authenticated before trying to access their data
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny([courseId]);
    }
    
    // Anyone can read site content, only faculty can write it.
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isFaculty();
    }

    // User profiles are readable by anyone, but can only be updated by the owner or faculty.
    match /users/{userId} {
      allow read: if true;
      allow update: if isOwner(userId) || isFaculty();
      // Creation and deletion is handled by backend logic, protected by faculty role checks there.
    }
    
    // User sub-collections (like 'patra' or 'missionCompletion') are private to the user and faculty.
    match /users/{userId}/{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isFaculty();
    }

    // Courses are readable by anyone, writable only by faculty.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isFaculty();
    }
    
    // All course subcollections (coupons, announcements, etc.) follow the course's write rule.
    match /courses/{courseId}/{collection}/{docId} {
        allow read: if true;
        allow write: if isFaculty();
    }
    
    // Anyone can read announcements, only faculty can manage them.
    match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if isFaculty();
    }
     match /announcements/{announcementId} {
        // Any signed-in user can update reactions.
        allow update: if isSignedIn() && request.resource.data.keys().hasOnly(['reactions']);
     }
    
    // --- Live Discussion Chat for Lessons ---
    // This is the simplified, crucial rule.
    match /courses/{courseId}/subjects/{subjectId}/chapters/{chapterId}/lessons/{lessonId}/liveChat/{messageId} {
      allow read: if true; // Everybody can read the chat
      allow create: if isFaculty() || isEnrolled(courseId); // Faculty or enrolled students can send messages
      allow update, delete: if isFaculty(); // Only faculty can moderate
    }
  }
}
