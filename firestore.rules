
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isFaculty() {
      // Checks if the requesting user has the 'faculty' role via custom claims.
      return request.auth.token.role == 'faculty';
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isEnrolled(courseId) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny([courseId]);
    }
    
    // ================== Rules ==================

    // Site-wide content (for maintenance mode, feature flags, etc.)
    // Anyone can read, but only faculty with a custom claim can write.
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isFaculty();
    }

    // User profiles are readable by anyone.
    // A user can update their own profile, and faculty can update any profile.
    match /users/{userId} {
      allow read: if true;
      allow update: if isOwner(userId) || isFaculty();
    }
    
    // User's private sub-collections (e.g., 'patra').
    match /users/{userId}/{subcollection}/{docId=**} {
      allow read, write: if isOwner(userId) || isFaculty();
    }

    // Courses are readable by anyone, writable only by faculty.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isFaculty();
    }
    
    // All subcollections within a course (live chat, coupons, etc.)
    match /courses/{courseId}/{collection}/{docId=**} {
      // Enrolled students can read and create. Faculty have full access.
      allow read, create: if isFaculty() || isEnrolled(courseId);
      // Only faculty can update or delete.
      allow update, delete: if isFaculty();
    }
    
    // Testimonials collection
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(request.resource.data.userId) || isFaculty();
      allow delete: if isFaculty();
    }
    
    // Rooms for Focus Zone & Warzone, and their subcollections
    match /rooms/{roomId}/{document=**} {
      allow read, write: if isSignedIn();
    }
    
    // Chambers for Parivartan, and their subcollections
    match /chambers/{chamberId}/{document=**} {
      // Only members of the chamber can access its content.
      allow read, write: if get(/databases/$(database)/documents/chambers/$(chamberId)).data.memberIds.hasAny([request.auth.uid]);
    }
    
    // Main announcements collection, writable only by faculty
    match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if isFaculty();
        // Exception: allow any signed-in user to update just the reactions
        allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys.hasOnly(['reactions']);
    }
  }
}

    