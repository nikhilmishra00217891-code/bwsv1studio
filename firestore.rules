
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isFaculty(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'faculty';
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null && isFaculty(request.auth.uid);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /siteContent/{docId} {
        allow read: if true;
        allow write: if request.auth != null && isFaculty(request.auth.uid);
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isFaculty(request.auth.uid);
      allow update (reactions): if request.auth != null; // Allow any authenticated user to react
    }
  }
}
