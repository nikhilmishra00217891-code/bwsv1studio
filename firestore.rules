
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isFaculty(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'faculty';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // COURSES
    match /courses/{courseId} {
      // Anyone can read active courses. Faculty can read any course.
      allow get: if resource.data.isActive == true || (isSignedIn() && isFaculty(request.auth.uid));
      
      // Anyone can see the list of active courses. Faculty can list all courses.
      allow list: if (isSignedIn() && isFaculty(request.auth.uid)) || request.query.where.isActive == true;

      // Only faculty can create, update, or delete courses.
      allow write: if isSignedIn() && isFaculty(request.auth.uid);
    }
    
    // LESSONS (subcollection)
    match /courses/{courseId}/lessons/{lessonId} {
        // Inherits read from parent course, but write is only for faculty
        allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.isActive == true || (isSignedIn() && isFaculty(request.auth.uid));
        allow write: if isSignedIn() && isFaculty(request.auth.uid);
    }

    // USERS
    match /users/{userId} {
      // Users can read/write their own profile.
      allow get, update: if isSignedIn() && isOwner(userId);
      // Anyone can create their own user document (on signup).
      allow create: if isSignedIn() && isOwner(userId);
       // Faculty can read any user's profile (needed for helper functions).
      allow get: if isSignedIn() && isFaculty(request.auth.uid);
    }
    
    // ANNOUNCEMENTS
    match /announcements/{announcementId} {
        // Anyone signed in can read announcements.
        allow read: if isSignedIn();
        // Only faculty can create/delete announcements.
        allow create, delete: if isSignedIn() && isFaculty(request.auth.uid);
        // Users can update reactions. Faculty can edit text.
        allow update: if isSignedIn() && (isFaculty(request.auth.uid) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
    }

    // SITE CONTENT
    match /siteContent/{docId} {
        // Publicly readable.
        allow get: if true;
        // Only faculty can write.
        allow write: if isSignedIn() && isFaculty(request.auth.uid);
    }
  }
}
