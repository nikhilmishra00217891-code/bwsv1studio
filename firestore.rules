rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is a faculty member
    function isFaculty() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty';
    }

    // Rules for the 'courses' collection
    match /courses/{courseId} {
      // ANYONE can get a single course if it is active. FACULTY can get any single course.
      allow get: if resource.data.isActive == true || isFaculty();

      // ANYONE can list/query courses that are active. FACULTY can list all courses.
      allow list: if request.query.limit <= 10 && (request.query.offset == null || request.query.offset == 0) || isFaculty();

      // ONLY FACULTY can create, update, or delete courses.
      allow create, update, delete: if isFaculty();
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // ANYONE can read a user's public profile info.
      allow get: if true;
      // ONLY the authenticated user can update their own profile.
      allow update: if request.auth.uid == userId;
    }

    // Rules for general site content (like editable text)
    match /siteContent/{docId} {
        // ANYONE can read site content.
        allow get: if true;
        // ONLY FACULTY can write to site content.
        allow write: if isFaculty();
    }

    // Rules for announcements
    match /announcements/{announcementId} {
        // Any authenticated user can read announcements.
        allow get, list: if request.auth != null;
        // Only faculty can create, update, or delete announcements.
        allow create, update, delete: if isFaculty();
    }
  }
}
