rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================
    function isFaculty() {
      // Checks if the requesting user has the 'faculty' role.
      return request.auth.token.role == 'faculty';
    }
    
    function isSignedIn() {
      // Checks if the user is authenticated.
      return request.auth != null;
    }

    function isOwner(userId) {
      // Checks if the requesting user is the owner of the document.
      return request.auth.uid == userId;
    }

    function isEnrolled(courseId) {
      // Checks if a user is enrolled in a specific course.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny([courseId]);
    }
    
    function isRoomMember(roomId) {
        // Checks if a user is a member of a specific room.
        return isSignedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]);
    }

    // =================================
    // Collection Rules
    // =================================

    // Site-wide content (maintenance mode, feature flags, etc.)
    // CRITICAL: Faculty must be able to write here.
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isFaculty();
    }
    
    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow update: if isOwner(userId) || isFaculty();
    }
    
    // User's private sub-collections (e.g., 'patra', 'missionCompletion')
    match /users/{userId}/{subcollection}/{docId=**} {
      allow read, write: if isOwner(userId) || isFaculty();
    }

    // Main course documents
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isFaculty();
    }
    
    // All subcollections within a course, including live chat, announcements, coupons.
    match /courses/{courseId}/{collection}/{docId=**} {
      // Enrolled students and faculty can read and create.
      allow read, create: if isFaculty() || isEnrolled(courseId);
      // Only faculty can moderate (update/delete).
      allow update, delete: if isFaculty();
    }
    
    // Global announcements collection (on the home page)
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isFaculty();
    }

    // Testimonials collection
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(request.resource.data.userId) || isFaculty();
      allow delete: if isFaculty();
    }
    
    // Rooms for Focus Zone & Warzone, and their subcollections (messages).
    match /rooms/{roomId}/{document=**} {
      // Only authenticated users who are members of the room can access its content.
      allow read, write: if isRoomMember(roomId);
    }
    
    // Chambers for Parivartan, and their subcollections (messages).
    match /chambers/{chamberId}/{document=**} {
      // Only authenticated users who are members of the chamber can access its content.
      allow read, write: if get(/databases/$(database)/documents/chambers/$(chamberId)).data.memberIds.hasAny([request.auth.uid]);
    }
  }
}
