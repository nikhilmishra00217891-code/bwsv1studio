
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is faculty
    function isFaculty(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.role == 'faculty';
    }

    // COURSES: Public can read active courses, faculty can read/write all
    match /courses/{courseId} {
      allow read: if resource.data.isActive == true || (request.auth != null && isFaculty(request.auth.uid));
      allow write: if request.auth != null && isFaculty(request.auth.uid);
    }
    
    // LESSONS: Inherit from course for now
    match /courses/{courseId}/lessons/{lessonId} {
       allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.isActive == true || (request.auth != null && isFaculty(request.auth.uid));
       allow write: if request.auth != null && isFaculty(request.auth.uid);
    }

    // USERS: A user's role is public, but their document is private.
    // Users can read/write their own full profile.
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;

      // Allow creating a user if they are a student, or if an existing faculty member is creating them.
      allow create: if (request.resource.data.role == 'student') || 
                    (request.resource.data.role == 'faculty' && isFaculty(request.auth.uid));
      
      // Prevent users from changing their own role after creation.
      allow update: if request.resource.data.role == resource.data.role; 
    }
    
    // ANNOUNCEMENTS: Logged-in users can read, faculty can write
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isFaculty(request.auth.uid);
    }
    
    // SITE CONTENT: Public can read, faculty can write
    match /siteContent/{docId} {
        allow read: if true;
        allow write: if request.auth != null && isFaculty(request.auth.uid);
    }

    // TESTIMONIALS: Public can read
     match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if request.auth != null && isFaculty(request.auth.uid);
    }
  }
}
