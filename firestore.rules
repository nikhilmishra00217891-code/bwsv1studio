
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is faculty
    function isFaculty(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'faculty';
    }
    
    // Helper function to check if a user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Courses can be read by anyone if they are active.
    // Only faculty can create, update, or delete courses.
    match /courses/{courseId} {
      allow read: if resource.data.isActive == true || (request.auth != null && isFaculty(request.auth.uid));
      allow create, update, delete: if request.auth != null && isFaculty(request.auth.uid);
      
      // Lessons are part of the course subcollection
      match /lessons/{lessonId} {
        allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.isActive == true || (request.auth != null && isFaculty(request.auth.uid));
        allow create, update, delete: if request.auth != null && isFaculty(request.auth.uid);
      }
    }

    // User data can be read and updated by the owner.
    // The 'role' field is readable by any authenticated user to allow for role checks.
    match /users/{userId} {
      allow read: if isOwner(userId) || request.auth != null;
      allow create, update: if isOwner(userId);
    }
    
    // Site content (for EditableText) can be read by anyone, but only updated by faculty.
    match /siteContent/{docId} {
        allow read: if true;
        allow write: if request.auth != null && isFaculty(request.auth.uid);
    }
    
    // Announcements can be read by anyone.
    // Only faculty can create, update, or delete them.
    match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && isFaculty(request.auth.uid);
    }
  }
}
